{
  "slug": "llm-wiki-plugin",
  "name": "Llm Wiki Plugin",
  "type": "plugin",
  "description": "Build and maintain an LLM-curated personal knowledge base in your project. Implements Andrej Karpathy's LLM Wiki pattern with sharded indexes, atomic pages, BM25 search, and a structural lint script - designed to scale to thousands of pages without becoming a context bottleneck.",
  "longDescription": "Ships **1 skill**, `llm-wiki` (Build and maintain an LLM-curated personal knowledge base — the \"LLM Wiki\" pattern from Andrej Karpathy's April 2026…) and **1 command**, `wiki`.\n\nInstalls with `claude plugin install llm-wiki-plugin@claude-community` from `praneybehl/llm-wiki-plugin`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "command": 1
  },
