{
  "slug": "credyt",
  "name": "Credyt",
  "type": "plugin",
  "description": "Real-time billing infrastructure for AI products: create products, track usage, manage wallets, and verify pricing directly from Claude.",
  "longDescription": "Ships **4 skills**.\n\n- **Skills** (4): `billing-integration` (Wire Credyt billing into your application code), `billing-setup` (Discover your billing model and configure products, assets, and pricing in Credyt via MCP), `billing-verification` (Test the full Credyt billing cycle end-to-end for a specific product), `pricing-strategy` (Guide users through defining their pricing strategy for an AI product or SaaS)\n\nInstalls with `claude plugin install credyt@claude-community` from `credyt/ai-skills`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
