{
  "slug": "agent-tasks",
  "name": "Agent Tasks",
  "type": "plugin",
  "description": "Pipeline-driven task management for AI coding agents. An MCP server with stage-gated pipelines, multi-agent collaboration, and a real-time kanban dashboard. Tasks flow through configurable stages — backlog, spec, plan, implement, test, review, done — with dependency tracking, approval workflows, artifact versioning, and threaded comments.",
  "longDescription": "Ships **1 MCP server**, `agent-tasks`.\n\nInstalls with `claude plugin install agent-tasks@claude-community` from `keshrath/agent-tasks`.\n\nPipeline-driven task management for AI coding agents. An MCP server with stage-gated pipelines, multi-agent collaboration, and a real-time kanban dashboard. Tasks flow through configurable stages — `backlog`, `spec`, `plan`, `implement`, `test`, `review`, `done` — with dependency tracking, approval workflows, artifact versioning, and threaded comments.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "mcp",
