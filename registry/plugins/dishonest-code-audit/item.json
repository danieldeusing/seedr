{
  "slug": "dishonest-code-audit",
  "name": "Dishonest Code Audit",
  "type": "plugin",
  "description": "Find code that lies to users: silent failures plus mock/stub/placeholder code in production paths. Supports JS/TS, Python, Go, Rust, Ruby via pluggable stack profiles.",
  "longDescription": "Ships **2 skills**, `dishonest-code-audit` (Find code that lies to the user), `stub-audit` (Audit a codebase for mock, stub, placeholder, or TODO code that lives in a real user-visible path (buttons…).\n\nInstalls with `claude plugin install dishonest-code-audit@claude-community` from `yhyatt/dishonest-code-audit`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
