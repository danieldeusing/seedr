{
  "slug": "claude-channel-mattermost",
  "name": "Claude Channel Mattermost",
  "type": "plugin",
  "description": "An MCP server that connects Mattermost to Claude Code — send and receive messages, manage files, and control access through a bot account.",
  "longDescription": "Ships **2 skills** and **1 MCP server**.\n\n- **Skills** (2): `access` (Manage Mattermost channel access — approve pairings, edit allowlists, set DM/group policy), `configure` (Set up the Mattermost channel — save the server URL and bot token, review access policy)\n- **MCP servers** (1): `mattermost`\n\nInstalls with `claude plugin install claude-channel-mattermost@claude-community` from `hayan89/claude-channel-mattermost`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
