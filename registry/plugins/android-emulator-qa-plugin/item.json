{
  "slug": "android-emulator-qa-plugin",
  "name": "Android Emulator Qa Plugin",
  "type": "plugin",
  "description": "Claude Android QA Plugin helps Claude Code test Android apps in an emulator. It can launch apps, inspect UI trees, derive safe tap coordinates, capture screenshots, and collect logcat evidence for QA and bug reproduction.",
  "longDescription": "Ships **2 skills**, `android-emulator-qa` (This skill should be used when validating Android feature flows in an emulator, reproducing Android UI bugs, driving…), `android-emulator-qa-command` (Drive Android emulator QA with adb, UI tree inspection, screenshots, and logcat evidence).\n\nInstalls with `claude plugin install android-emulator-qa-plugin@claude-community` from `ceabarr/claude-android-plugin`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
