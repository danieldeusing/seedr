{
  "slug": "avicenna",
  "name": "Avicenna",
  "type": "plugin",
  "description": "Code knowledge graph MCP extension — semantic code search, symbol lookup, and dependency analysis powered by tree-sitter and vector embeddings",
  "longDescription": "Ships **1 skill**, `avicenna-usage` (Instructions for using Avicenna code knowledge graph MCP tools effectively) and **1 MCP server**, `avicenna`.\n\nInstalls with `claude plugin install avicenna@claude-community` from `smrf1093/Avicenna`.\n\nCode knowledge graph MCP extension for Claude CLI. Reduces token usage by replacing brute-force file searching with intelligent, graph-aware code retrieval.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
