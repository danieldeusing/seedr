{
  "slug": "staff-engineer-mode",
  "name": "Staff Engineer Mode",
  "type": "plugin",
  "description": "Engineering lifecycle, DevOps, operations, reliability, security, architecture, and maintainability skills with automatic routing.",
  "longDescription": "Ships **1 skill** and **2 hooks**.\n\n- **Skills** (1): `staff-engineer-mode` (Use when engineering decisions span ideation, design, development, testing, release, operations, maintenance; API/reliability/security/data/doc lifecycle before process skills)\n- **Hooks** (2): `SessionStart`, `PreToolUse`\n\nInstalls with `claude plugin install staff-engineer-mode@claude-community` from `sirmarkz/staff-engineer-mode`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
