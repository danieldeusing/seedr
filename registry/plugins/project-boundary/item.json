{
  "slug": "project-boundary",
  "name": "Project Boundary",
  "type": "plugin",
  "description": "Blocks destructive commands outside the project directory. Allows file operations within the project (refactoring, cleanup) but prevents accidental damage outside it.",
  "longDescription": "Ships **2 hooks**, `SessionStart`, `PreToolUse`.\n\nInstalls with `claude plugin install project-boundary@claude-community` from `justi/claude-code-project-boundary`.\n\nAllows destructive operations within your project but blocks them outside the project directory. Built for `--dangerously-skip-permissions` mode where Claude doesn't ask — this plugin is your safety net.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "hook",
  "sourceType": "community",
  "author": {
    "name": "Justyna Wojtczak",
