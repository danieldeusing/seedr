{
  "slug": "casemgr-channel",
  "name": "Casemgr Channel",
  "type": "plugin",
  "description": "Pushes AI work items from CaseMgr — a shared workspace for you and your AI agent — into your running Claude Code session as channel events. When a CMMN workflow in CaseMgr produces a\npending work item, the plugin forwards it via SSE so Claude can claim, execute, and complete it without any human prompt. Uses Bearer-token auth, real-time event delivery with polling\nfallback, and a /casemgr-channel:configure skill for setup. Claude handles the actual work via the existing casemgr MCP tools (cases, notes, tasks, semantic search, file management,\nbilling, and 178 more).",
  "longDescription": "Ships **1 skill**, `configure` (Set up the CaseMgr channel — save the API token and verify it works) and **1 MCP server**, `casemgr-channel`.\n\nInstalls with `claude plugin install casemgr-channel@claude-community` from `mstang/casemgr-channel`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
