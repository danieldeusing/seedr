{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seedr Studio",
  "version": "0.1.0",
  "identifier": "dev.seedr.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6300",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Seedr Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
