{
  "slug": "linear-claude-skill",
  "name": "Linear Claude Skill",
  "type": "plugin",
  "description": "Manage Linear issues, projects, and teams directly from Claude Code. Create issues, update statuses, link projects to initiatives, and sync completed work.",
