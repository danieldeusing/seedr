{
  "slug": "peepshow",
  "name": "Peepshow",
  "type": "plugin",
  "description": "Turn videos + animated images into a timeline of still frames so LLMs can watch them. CLI + Claude Code plugin with 19 pluggable sinks.",
  "longDescription": "Ships **2 skills**, `sink` (Manage peepshow's persistent auto-sink list (list, add, remove, clear)), `slides` (Extract relevant frames from a video or animated image (GIF, APNG, animated WebP) so the model can view…).\n\nInstalls with `claude plugin install peepshow@claude-community` from `t0mtaylor/peepshow`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
  "author": {
    "name": "Tom Taylor"
  },
