{
  "slug": "asana",
  "name": "Asana",
  "type": "plugin",
  "description": "Asana project management integration. Connects Claude Code to Asana's V2 MCP server to create and manage tasks, search projects, update assignments, and track progress. Requires a one-time Asana OAuth app setup — run /asana-setup after installing.",
  "longDescription": "Connects to Asana's hosted MCP endpoint via SSE. Create, update, and search tasks, manage project assignments, and track progress from Claude Code. No local server to install -- connects directly to `mcp.asana.com`. Requires an Asana access token.",
