{
  "slug": "popper-probe",
  "name": "Popper Probe",
  "type": "plugin",
  "description": "A research companion based on Karl Popper's philosophy of falsification that interrogates your hypotheses to find what would prove them wrong. It acts like an adversarial supervisor by sharpening the scope, designing concrete experimentation setup, and referring to literature for state-of-the-art approaches.",
  "longDescription": "Ships **1 skill**, `intake` (Use when a researcher describes a research hypothesis, fuzzy claim, or empirical conjecture they want to test —…).\n\nInstalls with `claude plugin install popper-probe@claude-community` from `mashathepotato/popper-probe`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
