  "slug": "pylipidparse",
  "name": "Pylipidparse",
  "type": "plugin",
  "description": "PyLipidParse is a plugin to convert standard lipid shorthand notation (LIPID MAPS, SwissLipids, HMDB) to molecular structures with full stereochemistry information.",
