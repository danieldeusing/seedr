{
  "slug": "jar-explorer",
  "name": "Jar Explorer",
  "type": "plugin",
  "description": "Decompile and explore Java JAR files — read source code of dependencies, search packages, classes, methods, and fields.",
  "longDescription": "Ships **2 skills** and **1 agent**.\n\n- **Skills** (2): `explore-jar` (Explore Java JAR files — search classes, packages, methods, decompile source), `set-provider` (Switch the decompiler provider (native or vineflower))\n- **Agents** (1): `explore-jar` (Use this agent when you need to read, explore, or understand Java source code from JAR files)\n\nInstalls with `claude plugin install jar-explorer@claude-community` from `tarekst/jar-explorer`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
