{
  "slug": "agent-discover",
  "name": "Agent Discover",
  "type": "plugin",
  "description": "MCP server registry and on-demand proxy for AI coding agents. Browse the official MCP Registry, install/activate/deactivate servers from a local dashboard, and proxy their tools with namespace prefixing. Per-server secrets, health probes with error-count tracking, tool-call metrics, and a real-time call log via WebSocket.",
  "longDescription": "Ships **1 MCP server**, `agent-discover`.\n\nInstalls with `claude plugin install agent-discover@claude-community` from `keshrath/agent-discover`.\n\nMCP server registry and marketplace. Discover, install, activate, and manage MCP tools on demand. Acts as a dynamic proxy -- activated servers have their tools merged into the registry's own tool list, so agents can use them without restarting.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "mcp",
  "sourceType": "community",
  "author": {
    "name": "keshrath"
  },
