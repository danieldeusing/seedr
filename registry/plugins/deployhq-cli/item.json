{
  "slug": "deployhq-cli",
  "name": "Deployhq Cli",
  "type": "plugin",
  "description": "Deploy code, manage servers, and automate infrastructure via the DeployHQ CLI. A Go binary that wraps the full DeployHQ REST API, designed for both humans and AI agents. Features --json output with\n  breadcrumbs (suggested next commands), runtime self-discovery via dhq commands --json, and a comprehensive SKILL.md with decision trees. One-command setup: dhq setup claude.",
  "longDescription": "Ships **1 skill**, `deployhq` (Deploy code, manage servers, and automate infrastructure via the DeployHQ CLI (dhq)).\n\nInstalls with `claude plugin install deployhq-cli@claude-community` from `deployhq/deployhq-cli`.\n\nDeployHQ from your terminal -- for humans and agents.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
