{
  "slug": "ru-text",
  "name": "Ru Text",
  "type": "plugin",
  "description": "Russian text quality plugin. Auto-activates on Russian text output and applies ~1,040 rules across typography, information style, editorial standards, UX writing, and business correspondence. Eight reference files load on demand. No network calls, no telemetry.",
  "longDescription": "Ships **3 skills**.\n\n- **Skills** (3): `ru-check` (Full Russian text quality check against the whole corpus), `ru-score` (Score Russian text 0.0–10.0 across five dimensions: typography, clean language, grammar, structure, precision for the reader), `ru-text` (Russian text quality)\n\nInstalls with `claude plugin install ru-text@claude-community` from `talkstream/ru-text`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
