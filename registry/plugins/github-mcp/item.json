{
  "slug": "github-mcp",
  "name": "Github Mcp",
  "type": "plugin",
  "description": "Self-hosted GitHub MCP server. PAT auth, stdio transport, works with Claude Code, Codex CLI, Cursor, or any MCP-compliant client.",
  "longDescription": "Ships **1 hook**, `SessionStart` and **1 MCP server**, `github`.\n\nInstalls with `claude plugin install github-mcp@claude-community` from `adelaidasofia/github-mcp`.\n\nSelf-hosted GitHub MCP server. Personal-access-token auth, stdio transport, transport-agnostic so it works with Claude Code (any account), Codex CLI, Cursor, or any MCP-compliant client. No claude.ai OAuth dependency.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "hook": 1,
    "mcp": 1
  },
