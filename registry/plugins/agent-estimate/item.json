{
  "slug": "agent-estimate",
  "name": "Agent Estimate",
  "type": "plugin",
  "description": "Effort estimation for AI coding agents. PERT three-point estimation with METR reliability thresholds, modifier stacks (spec clarity, warm context, agent fit), and wave planning for multi-agent parallel execution. Supports single tasks, batch files, and GitHub issues.",
  "longDescription": "Ships **1 skill**, `claude` (Estimate effort for AI coding agent tasks using PERT three-point estimation with METR reliability thresholds and wave planning).\n\nInstalls with `claude plugin install agent-estimate@claude-community` from `haoranc/agent-estimate`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
  "author": {
    "name": "Kiloloop"
  },
