{
  "slug": "agent-runway",
  "name": "Agent Runway",
  "type": "plugin",
  "description": "Prevents subagent tech debt by injecting project architectural context (module boundaries, CLAUDE.md rules, conventions) into every subagent's prompt. Validates code placement and conventions after writes with self-correction directives.",
  "longDescription": "Ships **1 skill** and **3 hooks**.\n\n- **Skills** (1): `runway-status` (Check the current Agent Runway status - loaded architectural map, active conventions, module boundaries, and enforcement levels)\n- **Hooks** (3): `SessionStart`, `PreToolUse`, `PostToolUse`\n\nInstalls with `claude plugin install agent-runway@claude-community` from `rennf93/agent-runway`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 3
  },
  "sourceType": "community",
  "author": {
    "name": "Renzo Franceschini"
  },
