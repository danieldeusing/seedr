{
  "slug": "searching-apple-notes",
  "name": "Searching Apple Notes",
  "type": "plugin",
  "description": "Semantic search and note creation for Apple Notes. Talk to Claude in natural language — it searches your notes by meaning (not keywords), answers with citations, and writes new notes back. Powered by BGE-M3 embeddings and ChromaDB, all running locally on your Mac. No API keys, no cloud services. Native support for Chinese-English mixed content and 100+ languages.",
  "longDescription": "Ships **1 skill**, `searching-apple-notes` (Search, recall, and create Apple Notes via semantic vector search powered by Qwen3-Embedding-0.6B and ChromaDB).\n\nInstalls with `claude plugin install searching-apple-notes@claude-community` from `yinanli1917-cloud/searching-apple-notes`.\n\nEnglish | 中文",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
