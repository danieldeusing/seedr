{
  "slug": "repo-recap",
  "name": "Repo Recap",
  "type": "plugin",
  "description": "Generate structured summaries of your git repository activity with a single slash command. \n\nSee who did what, which areas changed, and the most active files — organized by contributor, directory, and file churn. \n\nWhen the GitHub CLI (gh) is installed, recaps are automatically enriched with pull request titles, descriptions, labels, review status, and linked issues.",
  "longDescription": "Ships **1 skill**, `recap` (Generate a summary of what happened in your repository over a given time period) and **1 agent**, `recap-agent` (Analyzes git history and produces a layered repository recap).\n\nInstalls with `claude plugin install repo-recap@claude-community` from `nikodem-wrona/repo-recap`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "agent": 1
  },
