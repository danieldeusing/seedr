{
  "slug": "claude-account-guard",
  "name": "Claude Account Guard",
  "type": "plugin",
  "description": "A Claude Code plugin that warns or blocks prompts when the active Claude account doesn't match the expected account for the current directory.\n\nUseful for teams or individuals who switch between work and personal Claude accounts and want a guardrail against accidentally using the wrong one.",
  "longDescription": "Ships **1 skill**, `account-status` (Show the currently active Claude account and evaluate the account-guard policy for the current (or specified) directory) and **1 hook**, `UserPromptSubmit`.\n\nInstalls with `claude plugin install claude-account-guard@claude-community` from `fseitun/claude-account-guard`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
