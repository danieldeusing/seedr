{
  "slug": "lua-lsp",
  "name": "Lua LSP",
  "type": "plugin",
  "description": "Lua language server for code intelligence",
  "longDescription": "Integrates `lua-language-server` for Lua files (`.lua`). Provides code intelligence, completions, and diagnostics. Install via `brew install lua-language-server` (macOS), `snap install lua-language-server` (Ubuntu), `pacman -S lua-language-server` (Arch), `dnf install lua-language-server` (Fedora), or pre-built binaries from GitHub releases.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/e0ab6e51219eef74e417a0e1d89e5d53e5e763d4/plugins/lua-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "lua": {
      "command": "lua-language-server",
      "extensionToLanguage": {
        ".lua": "lua"
      }
    }
  },
