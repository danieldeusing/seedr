{
  "slug": "kotlin-lsp",
  "name": "Kotlin Lsp",
  "type": "plugin",
  "description": "Kotlin language server for code intelligence",
  "longDescription": "Wires JetBrains' official Kotlin language server into Claude Code for `.kt` and `.kts` files, adding code intelligence, refactoring, and analysis on top of plain-text editing. Requires the Kotlin LSP CLI — install with `brew install JetBrains/utils/kotlin-lsp`. No configuration needed beyond the plugin and the server binary.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/ed404106fcd80ba98ecb7c851e531dcb626d13b7/plugins/kotlin-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "kotlin-lsp": {
      "command": "kotlin-lsp",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".kt": "kotlin",
        ".kts": "kotlin"
      },
      "startupTimeout": 120000
    }
  },
