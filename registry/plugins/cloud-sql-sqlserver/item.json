{
  "slug": "cloud-sql-sqlserver",
  "name": "Cloud Sql Sqlserver",
  "type": "plugin",
  "description": "Connect to Cloud SQL for SQL Server",
  "longDescription": "Ships **1 MCP server**, `cloud-sql-mssql`.\n\nInstalls with `claude plugin install cloud-sql-sqlserver@claude-plugins-official` from `gemini-cli-extensions/cloud-sql-sqlserver`.\n\nThis repository packages MCP Toolbox's prebuilt `cloud-sql-mssql` server as a plugin/extension to interact with Cloud SQL for SQL Server instances. It can be used with various AI agents, including Antigravity, Claude Code and Codex, to manage your databases, execute queries, explore schemas, and troubleshoot issues using natural language prompts.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
