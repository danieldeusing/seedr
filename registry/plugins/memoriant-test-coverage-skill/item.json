{
  "slug": "memoriant-test-coverage-skill",
  "name": "Memoriant Test Coverage Skill",
  "type": "plugin",
  "description": "AST-powered test coverage analysis for Claude Code. Scans source and test directories, identifies untested functions by parsing Python abstract syntax trees, and generates pytest test skeletons automatically. Finds coverage gaps that line-based tools miss by understanding function signatures, class methods, and module structure.",
  "longDescription": "Ships **1 skill**, `semantic-test-coverage` (Analyze a Python project for untested functions using AST inspection and generate pytest skeleton files for every coverage…) and **1 agent**, `test-coverage-agent` (Autonomous agent that audits Python projects for semantic test coverage gaps and generates pytest skeleton files to close…).\n\nInstalls with `claude plugin install memoriant-test-coverage-skill@claude-community` from `NathanMaine/memoriant-test-coverage-skill`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
