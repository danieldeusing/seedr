{
  "slug": "tldiagram-create-diagram",
  "name": "Tldiagram Create Diagram",
  "type": "plugin",
  "description": "Automatic creation of codebase diagrams for use in tldiagram.com",
  "longDescription": "Ships **1 skill**, `create-diagram` (Create architecture diagrams from a codebase using the tld CLI).\n\nInstalls with `claude plugin install tldiagram-create-diagram@claude-community` from `Mertcikla/tld-cli`.\n\ntld is a command-line interface for managing software architecture diagrams as code. It is a companion app designed for use with tlDiagram.com. It lets you define your architecture in YAML, validate the consistency of your definitions, and sync them to tlDiagram.com.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
