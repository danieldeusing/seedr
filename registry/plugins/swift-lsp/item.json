{
  "slug": "swift-lsp",
  "name": "Swift LSP",
  "type": "plugin",
  "description": "Swift language server (SourceKit-LSP) for code intelligence",
  "longDescription": "Integrates `sourcekit-lsp` (SourceKit-LSP) as a language server for Swift files (`.swift`). Provides code intelligence, completions, go-to-definition, and diagnostics. Included with the Swift toolchain — install Xcode or `brew install swift` (macOS), or Swift from swift.org (Linux). No separate installation required if Swift is already available.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/f75f5b25ae94f4332be4ff5f18435741d2589bdb/plugins/swift-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "sourcekit-lsp": {
      "command": "sourcekit-lsp",
      "extensionToLanguage": {
        ".swift": "swift"
      }
    }
  },
