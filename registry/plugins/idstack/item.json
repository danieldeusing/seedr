{
  "slug": "idstack",
  "name": "Idstack",
  "type": "plugin",
  "description": "Evidence-based instructional design pipeline. 11 skills backed by peer-reviewed research across 11 domains. Analyze, design, build, review, and export courses with every recommendation citing its evidence tier (T1 meta-analyses through T5 expert opinion).",
  "longDescription": "Ships **11 skills**.\n\n- **Skills** (11): `accessibility-review` (WCAG 2.1 AA compliance audit plus Universal Design for Learning (UDL 3.0) enhancement review for course designs), `assessment-design` (Evidence-based assessment design with rubrics, feedback strategies, and formative checkpoints), `course-builder` (Generate complete course content from the idstack manifest), `course-export` (Export course content to any LMS), `course-import` (Universal course import from any LMS), `course-quality-review` (Evidence-based course quality audit aligned with Quality Matters standards and Community of Inquiry framework), `learn` (Manage project learnings), `learning-objectives` (Evidence-based learning objective development with revised Bloom's taxonomy classification and bidirectional alignment checking), and 3 more\n\nInstalls with `claude plugin install idstack@claude-community` from `savvides/idstack`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
