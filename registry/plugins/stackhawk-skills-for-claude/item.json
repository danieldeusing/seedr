{
  "slug": "stackhawk-skills-for-claude",
  "name": "Stackhawk Skills For Claude",
  "type": "plugin",
  "description": "Your AI coding agent is also your security team.\n\nStackHawk skills teach Claude to find security vulnerabilities as you build, report your security posture across applications, and help you fix what it finds — all without leaving your workflow. No context switching, no tickets to another team. Your agent scans, reports, and remediates.\n\nWorks with Claude Code, the Claude desktop app, and anywhere Claude skills are supported.",
  "longDescription": "Ships **1 skill**, `skill-authoring` (Guides authoring and maintaining agent skills in this repository — enforcing Anthropic best practices, bumping versions, regenerating Cursor…).\n\nInstalls with `claude plugin install stackhawk-skills-for-claude@claude-community` from `stackhawk/claude-skills`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
