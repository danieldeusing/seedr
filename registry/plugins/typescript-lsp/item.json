{
  "slug": "typescript-lsp",
  "name": "TypeScript LSP",
  "type": "plugin",
  "description": "TypeScript/JavaScript language server for enhanced code intelligence",
  "longDescription": "Integrates `typescript-language-server` for TypeScript and JavaScript files (`.ts`, `.tsx`, `.js`, `.jsx`, `.mts`, `.cts`, `.mjs`, `.cjs`). Provides go-to-definition, find references, completions, and error checking. Install via `npm install -g typescript-language-server typescript`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/b819188d2eea14e0400556ca29dbd1179a7c595b/plugins/typescript-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  },
