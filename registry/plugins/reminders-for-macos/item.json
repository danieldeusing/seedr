{
  "slug": "reminders-for-macos",
  "name": "Reminders For Macos",
  "type": "plugin",
  "description": "Fast, native macOS Apple Reminders integration via Apple's EventKit framework. Thirteen MCP tools cover the full lifecycle: list, search, today/overdue/scheduled queries, and create/update/complete/delete. Signed and notarized Swift binary, 10-200x faster than AppleScript. 100% local at runtime, no telemetry.",
  "longDescription": "Ships **1 skill**, `apple-reminders` (Read and write Apple Reminders on macOS with sub-second latency via a self-contained EventKit binary) and **1 hook**, `SessionStart`.\n\nInstalls with `claude plugin install reminders-for-macos@claude-community` from `high5-ventures/apple-reminders-for-claude`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
  "sourceType": "community",
