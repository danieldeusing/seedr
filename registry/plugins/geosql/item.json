{
  "slug": "geosql",
  "name": "Geosql",
  "type": "plugin",
  "description": "Geospatial SQL skill for BigQuery and Snowflake. Discovers warehouse schemas, writes cost-safe SQL with mandatory dry-run, validates results, and optionally renders an interactive map.",
  "longDescription": "Ships **1 skill**, `geosql` (Build cost-safe Geospatial SQL for BigQuery, Snowflake, Wherobots and Postgres and/or render results on an interactive Dekart map).\n\nInstalls with `claude plugin install geosql@claude-community` from `dekart-xyz/geosql`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
