{
  "slug": "audit-context-building",
  "name": "Audit Context Building",
  "type": "plugin",
  "description": "Understand a codebase before looking for bugs in it. Reads it function by function, records what each one assumes and depends on, and saves the write-ups to files instead of filling up the conversation.",
  "longDescription": "Security audit plugin from Trail of Bits with a `/audit-context` command, a function-analyzer agent, and an audit-context-building skill with completeness checklists. Maps codebase architecture at function-level granularity before hunting vulnerabilities, so findings include full context about impact and interactions. Supports a `--focus` flag for targeted module analysis.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
