{
  "slug": "claude-hud",
  "name": "Claude Hud",
  "type": "plugin",
  "description": "Real-time statusline HUD for Claude Code - context health, tool activity, agent tracking, and todo progress",
  "longDescription": "Ships **2 commands**, `configure` (Configure HUD display options (layout, language, presets, display elements) while preserving advanced manual overrides), `setup` (Configure claude-hud as your statusline).\n\nInstalls with `claude plugin install claude-hud@claude-community` from `jarrodwatts/claude-hud`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "command",
  "sourceType": "community",
  "author": {
    "name": "Jarrod Watts",
    "url": "https://github.com/jarrodwatts"
  },
