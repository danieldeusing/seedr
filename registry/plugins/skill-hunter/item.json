{
  "slug": "skill-hunter",
  "name": "Skill Hunter",
  "type": "plugin",
  "description": "▎Before you implement anything, scan for existing skills, MCP servers, CLI tools, plugins, or APIs that already solve the task.\n▎ Presents the best candidate with risk and effort, or a shortlist of three, and asks for approval before writing code. Stops you\n▎ from rebuilding what already exists.",
  "longDescription": "Ships **1 skill**, `skill_hunter` (ALWAYS invoke this skill FIRST, BEFORE writing code or taking implementation steps, whenever the user asks to write,…) and **1 hook**, `UserPromptSubmit`.\n\nInstalls with `claude plugin install skill-hunter@claude-community` from `mturac/skill-hunter`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
