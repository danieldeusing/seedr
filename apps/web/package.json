{
  "name": "@seedr/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "tsx scripts/generate-registry-keys.mjs && node scripts/vendor-playground-assets.mjs",
    "dev": "pnpm run prepare:assets --keep-previous && vite",
    "build": "pnpm run prepare:assets && tsc && vite build && tsx scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsx scripts/generate-registry-keys.mjs && tsc --noEmit && tsc -p functions && tsc -p tests",
    "lint": "eslint src functions scripts tests public/playgrounds",
    "lint:fix": "eslint src functions scripts tests public/playgrounds --fix",
    "test": "tsx scripts/generate-registry-keys.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "tsx scripts/generate-registry-keys.mjs && vitest run --coverage",
    "test:api": "tsx scripts/generate-registry-keys.mjs && vitest run functions",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --grep @live",
    "clean": "rm -rf dist test-results playwright-report public/playgrounds/vendor functions/registry-keys.generated.ts"
  },
  "dependencies": {
    "@danieldeusing/design": "^0.64.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@seedr/registry-ops": "workspace:*",
    "@seedr/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.575.0",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^4.20260611.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
