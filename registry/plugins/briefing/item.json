{
  "slug": "briefing",
  "name": "Briefing",
  "type": "plugin",
  "description": "A Claude Code plugin that lets a subagent declare its required skills in frontmatter — and guarantees they are loaded before the agent thinks its first thought. No \"MANDATORY: load X first\" pleading in the body. No silent skips. The skills are simply there when the agent wakes up.",
  "longDescription": "Ships **1 skill**, `briefing` (Author and migrate Claude Code subagents that use the `briefing` plugin — the PreToolUse hook that pre-loads declared…) and **1 hook**, `PreToolUse`.\n\nInstalls with `claude plugin install briefing@claude-community` from `Getty/briefing`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
  "sourceType": "community",
  "author": {
    "name": "Torsten Raudssus"
  },
