{
  "slug": "phd-deepread",
  "name": "Phd Deepread",
  "type": "plugin",
  "description": "Transform academic PDFs into structured literature notes and critical-thinking canvases for Obsidian. Extracts text from PDFs, then Claude generates a structured note with evidence tables, validity-mapped critique, and 25+ wikilinks. Outputs a 9-node JSON canvas for visual critical-thinking analysis in Obsidian.",
  "longDescription": "Ships **1 skill**, `phd-deepread`.\n\nInstalls with `claude plugin install phd-deepread@claude-community` from `heleninsights-dot/phd-deepread-workflow`.\n\nBush imagined this in 1945 — a desk where all your reading lives outside its original containers, ready for you to build trails of association through it. That's what this workflow is.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
