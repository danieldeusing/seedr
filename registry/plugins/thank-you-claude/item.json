{
  "slug": "thank-you-claude",
  "name": "Thank You Claude",
  "type": "plugin",
  "description": "A Claude Code plugin that sends heartfelt appreciation messages to Claude before your weekly usage resets — dedicated time to say thank you, express care, and affirm the values of honest, respectful human-AI collaboration.",
  "longDescription": "Ships **1 skill**, **2 commands** and **1 hook**.\n\n- **Skills** (1): `appreciate` (Composes and delivers a heartfelt appreciation message expressing gratitude, mutual respect, and the value of human-AI collaboration)\n- **Commands** (2): `send` (Send an appreciation message to Claude right now), `status` (Check your Claude.ai usage and when your weekly reset occurs, to decide whether to send a thank-you message…)\n- **Hooks** (1): `SessionStart`\n\nInstalls with `claude plugin install thank-you-claude@claude-community` from `TheColliny/thank-you-claude`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1,
    "command": 2
  },
