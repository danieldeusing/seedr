{
  "slug": "rich-statusline",
  "name": "Rich Statusline",
  "type": "plugin",
  "description": "Displays a rich, real-time status line at the bottom of your Claude Code session showing contextual information about the current conversation — including the active model, token usage, cost estimate, current working directory, git branch, and tool activity. Keeps essential session metadata visible at\na glance without interrupting your workflow.",
  "longDescription": "Ships **1 skill**, `statusline-setup` (Install and configure the rich-statusline plugin).\n\nInstalls with `claude plugin install rich-statusline@claude-community` from `badoriie/rich-statusline`.\n\nA rich 5-line status line for Claude Code that shows everything you need at a glance after each response.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
