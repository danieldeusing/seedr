{
  "slug": "claude-code-achievements",
  "name": "Claude Code Achievements",
  "type": "plugin",
  "description": "Steam-style achievement system for Claude Code",
  "longDescription": "Ships **2 commands** and **2 hooks**.\n\n- **Commands** (2): `achievements-settings` (Configure your achievements settings), `achievements` (Display your Claude Code achievements progress)\n- **Hooks** (2): `PostToolUse`, `Stop`\n\nInstalls with `claude plugin install claude-code-achievements@claude-community` from `subinium/claude-code-achievements`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "hook": 2,
    "command": 2
  },
