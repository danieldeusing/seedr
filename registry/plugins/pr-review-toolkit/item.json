{
  "slug": "pr-review-toolkit",
  "name": "Pr Review Toolkit",
  "type": "plugin",
  "description": "Comprehensive PR review agents specializing in comments, tests, error handling, type design, code quality, and code simplification",
  "longDescription": "Adds a `/review-pr` command that dispatches **6 specialized agents** in parallel:\n\n- **code-reviewer**: general quality\n- **code-simplifier**: unnecessary complexity\n- **comment-analyzer**: comment accuracy and staleness\n- **pr-test-analyzer**: test coverage gaps\n- **silent-failure-hunter**: swallowed errors and missing error paths\n- **type-design-analyzer**: type safety and design issues\n\nEach agent reviews independently for thorough PR coverage.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "agent": 6,
    "command": 1
  },
