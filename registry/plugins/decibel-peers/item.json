{
  "slug": "decibel-peers",
  "name": "Decibel Peers",
  "type": "plugin",
  "description": "Peer network patterns for Claude Code agent specialization. Peers gives Claude instances structured identity, discovery, messaging, and handoff protocols so specialist reviewers can coordinate cleanly across sessions",
  "longDescription": "Ships **2 skills**, `peer-identity` (Use when setting up a Claude Code instance as a specialist peer — defines identity schema, capability advertisement,…), `peer-messaging` (Use when sending or receiving messages between Claude Code peers — defines request format, review artifact format, and…).\n\nInstalls with `claude plugin install decibel-peers@claude-community` from `decibelsystems/peers`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
