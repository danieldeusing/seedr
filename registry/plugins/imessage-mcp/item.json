{
  "slug": "imessage-mcp",
  "name": "Imessage Mcp",
  "type": "plugin",
  "description": "macOS-only iMessage MCP server. Direct chat.db read, voice-note transcription, FTS5 search, AppleScript send with draft+confirm.",
  "longDescription": "Ships **1 hook**, `SessionStart` and **1 MCP server**, `imessage`.\n\nInstalls with `claude plugin install imessage-mcp@claude-community` from `adelaidasofia/imessage-mcp`.\n\nmacOS-only MCP server that exposes iMessage history to Claude and exports per-chat conversations into an Obsidian vault. Mirrors the whatsapp-mcp pattern: same hook, same launchd cadence, same vault shape.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "hook": 1,
    "mcp": 1
  },
