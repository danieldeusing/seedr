{
  "slug": "clawback",
  "name": "Clawback",
  "type": "plugin",
  "description": "Webhooks and cron scheduling for Claude Code. Receive events\nfrom external services like GitHub, Stripe, and Sentry, route\nthem to the right session, and let Claude act on them\nautomatically. Events are durably queued, delivered one at a\ntime, and survive connection drops.",
  "longDescription": "Ships **1 skill**, `configure` (Set up the Clawback channel — save the connection token and check status) and **1 MCP server**, `clawback`.\n\nInstalls with `claude plugin install clawback@claude-community` from `clawback-io/clawback`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
