{
  "slug": "claude-notify",
  "name": "Claude Notify",
  "type": "plugin",
  "description": "Plays audio notifications when Claude Code finishes a response or pauses waiting for your permission approval. Keeps you in the loop without watching the terminal. Supports macOS (system sounds), Linux (PulseAudio), and Windows (Git Bash/WSL).",
  "longDescription": "Ships **2 hooks**, `Stop`, `PermissionRequest`.\n\nInstalls with `claude plugin install claude-notify@claude-community` from `hiskuDN/claude-notify`.\n\nPlatforms: macOS (native banners + click-to-focus) · Linux (PulseAudio / ALSA / libnotify) · Windows (Git Bash / WSL)",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "hook",
