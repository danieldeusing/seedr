{
  "slug": "rex",
  "name": "Rex",
  "type": "plugin",
  "description": "Rex provides sub-second Python symbol search across all installed .venv packages. Three tools — rex_find, rex_show, rex_members — let Claude look up function signatures, docstrings, class members, and file locations instantly, without web search or grepping through source files. Results are grounded in the actually installed version — no outdated docs, no hallucinated parameters. Auto-indexes on first use and re-indexes incrementally when packages change. Read-only by design.",
  "longDescription": "Ships **1 skill**, `rex` (This skill should be used when the user asks \"what's the signature of\", \"how do I use X…) and **1 MCP server**, `rex`.\n\nInstalls with `claude plugin install rex@claude-community` from `vykhovanets/rex`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "mcp": 1
  },
