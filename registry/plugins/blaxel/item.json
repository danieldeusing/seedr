{
  "slug": "blaxel",
  "name": "Blaxel",
  "type": "plugin",
  "description": "Blaxel is the perpetual sandbox platform. It lets you keep infinite, secure sandboxes on automatic standby, while co-hosting your agents and context for near instant latency. The Blaxel agent skill lets your agent create cloud sandboxes (microVMs) to run code, start dev servers, and generate live preview URLs.",
  "longDescription": "Ships **2 skills**, `blaxel-cli` (Manage Blaxel resources from the command line using the bl CLI), `blaxel-sdk` (Use when creating cloud sandboxes (microVMs) to run code, start dev servers, and generate live preview URLs).\n\nInstalls with `claude plugin install blaxel@claude-community` from `blaxel-ai/agent-skills`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
