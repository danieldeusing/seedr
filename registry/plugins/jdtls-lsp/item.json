{
  "slug": "jdtls-lsp",
  "name": "Jdtls Lsp",
  "type": "plugin",
  "description": "Java language server (Eclipse JDT.LS) for code intelligence",
  "longDescription": "Wires the Eclipse JDT.LS Java language server into Claude Code for `.java` files, giving real code intelligence (go-to-definition, references, diagnostics) and refactoring instead of plain-text edits. Requires Java 17+ and a `jdtls` binary on PATH — install via `brew install jdtls` on macOS or your distro's package manager on Linux.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/340e33aef211d95769d252324854497af871dafe/plugins/jdtls-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "jdtls": {
      "command": "jdtls",
      "extensionToLanguage": {
        ".java": "java"
      },
      "startupTimeout": 120000
    }
  },
