{
  "slug": "agent-comm",
  "name": "Agent Comm",
  "type": "plugin",
  "description": "Agent-agnostic intercommunication system. Lets AI coding agents — talk to each other, share state, and coordinate work in real time.",
  "longDescription": "Ships **1 MCP server**, `agent-comm`.\n\nInstalls with `claude plugin install agent-comm@claude-community` from `keshrath/agent-comm`.\n\nAgent-agnostic intercommunication system. Lets AI coding agents — Claude Code, Codex CLI, Gemini CLI, Aider, or any custom tool — talk to each other, share state, and coordinate work in real time.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "mcp",
  "sourceType": "community",
