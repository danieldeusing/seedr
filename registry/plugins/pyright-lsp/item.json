{
  "slug": "pyright-lsp",
  "name": "Pyright LSP",
  "type": "plugin",
  "description": "Python language server (Pyright) for type checking and code intelligence",
  "longDescription": "Integrates Microsoft `pyright` as a language server for Python files (`.py`, `.pyi`). Provides static type checking, code intelligence, go-to-definition, find references, and diagnostics. Install via `npm install -g pyright`, `pip install pyright`, or `pipx install pyright`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/f75f5b25ae94f4332be4ff5f18435741d2589bdb/plugins/pyright-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "pyright": {
      "command": "pyright-langserver",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  },
