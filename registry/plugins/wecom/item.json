{
  "slug": "wecom",
  "name": "Wecom",
  "type": "plugin",
  "description": "WeCom (Enterprise WeChat) Channel Plugin for Claude Code — enables two-way messaging between Claude  Code sessions and WeCom users via AI Bot or Self-built App mode.",
  "longDescription": "Ships **2 skills**, `access` (Manage WeCom channel access control — pair users, list/add/remove allowed users, and set access mode), `configure` (Configure WeCom channel credentials and connection settings).\n\nInstalls with `claude plugin install wecom@claude-community` from `yangsjt/claude-channel-wecom`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
