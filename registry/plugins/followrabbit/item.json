{
  "slug": "followrabbit",
  "name": "Followrabbit",
  "type": "plugin",
  "description": "Cloud cost optimization for GCP infrastructure. Review changes for cost impact and auto-apply savings recommendations using the followrabbit CLI.",
  "longDescription": "Ships **1 skill**, `cost-review` (Perform a FollowRabbit cost review on the current repository) and **1 agent**, `cost-optimizer` (Use this agent when the user is working with cloud infrastructure (Terraform, GCP, SQL) and discusses cost, pricing,…).\n\nInstalls with `claude plugin install followrabbit@claude-community` from `followrabbit-ai/awesome-rabbit`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
