{
  "slug": "statusline",
  "name": "Statusline",
  "type": "plugin",
  "description": "Themeable status line for Claude Code — shows project name, git branch, context usage, model, rate limits, and session stats at a glance. Four built-in themes (powerline, minimal, compact, full), three detail levels, and custom theme support.\nLike zsh themes for your AI coding sessions.",
  "longDescription": "Ships **2 skills** and **1 hook**.\n\n- **Skills** (2): `setup` (Install or configure the statusline plugin in your settings.json), `sl` (Switch Claude Code status line theme or detail level)\n- **Hooks** (1): `SessionStart`\n\nInstalls with `claude plugin install statusline@claude-community` from `dan1d/statusline`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 2,
    "hook": 1
  },
