{
  "slug": "memoriant-docforce-skill",
  "name": "Memoriant Docforce Skill",
  "type": "plugin",
  "description": "Documentation drift detection for Claude Code. Compares code, config files, and API endpoints against documentation to find stale, missing, or inaccurate docs. Classifies mismatches by severity (critical, warning, info) with evidence logging. Catches drift before users do.",
  "longDescription": "Ships **1 skill**, `doc-drift-monitor` (Compare code and config files against their documentation to find drift — places where the docs say one…) and **1 agent**, `docforce-agent` (Autonomous agent that monitors documentation drift — compares code and config files against documentation, surfaces every mismatch with…).\n\nInstalls with `claude plugin install memoriant-docforce-skill@claude-community` from `NathanMaine/memoriant-docforce-skill`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "agent": 1
  },
