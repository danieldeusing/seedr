  "slug": "shipwright-brain",
  "name": "Shipwright Brain",
  "type": "plugin",
  "description": "Persistent memory for Claude Code. Markdown files, no database. Brain remembers ideas, decisions, features, and progress across sessions so Claude doesn't start from zero every time.",
