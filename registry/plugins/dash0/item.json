{
  "slug": "dash0",
  "name": "Dash0",
  "type": "plugin",
  "description": "OpenTelemetry observability for Claude Code sessions. Captures tool calls, LLM invocations, token usage, and errors as OTel traces. Send telemetry to Dash0 or any OpenTelemetry-compatible backend.",
  "longDescription": "Ships **2 skills**, `copilot-local-dev` (Install and run the Dash0 GitHub Copilot CLI plugin (the copilot/ package) locally for development/testing — no GitHub…), `dash0-configure` (Set up or finish setting up the Dash0 → Claude Code telemetry integration by writing ~/.claude/dash0-agent-plugin.local.md (or the…).\n\nInstalls with `claude plugin install dash0@claude-plugins-official` from `dash0hq/dash0-agent-plugin`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
  "author": {
    "name": "Dash0"
  },
