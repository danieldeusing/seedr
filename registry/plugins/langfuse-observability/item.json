{
  "slug": "langfuse-observability",
  "name": "Langfuse Observability",
  "type": "plugin",
  "description": "Langfuse observability plugin for Claude Code — captures and exports traces, spans, and session telemetry from Claude Code to Langfuse for LLM monitoring, debugging, and evaluation",
  "longDescription": "Ships **2 hooks**, `Stop`, `SessionEnd`.\n\nInstalls with `claude plugin install langfuse-observability@claude-plugins-official` from `langfuse/claude-observability-plugin`.\n\nThis plugin sends Claude Code sessions to Langfuse. It records the user prompts, the agent turns, the model generations with their tokens and cost, and the tool calls, with no change to your code.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "hook",
  "sourceType": "community",
  "author": {
    "name": "Langfuse"
  },
