{
  "slug": "slidecast",
  "name": "Slidecast",
  "type": "plugin",
  "description": "Generate self-contained HTML presentations and convert them into voiced, slide-synced MP4 videos using ElevenLabs text-to-speech. Bring your own ElevenLabs API key.",
  "longDescription": "Ships **2 skills**, `create-presentation` (Generate a polished, self-contained HTML slide deck from a topic, outline, or document), `narrate-to-video` (Convert an existing HTML slide deck into a narrated, slide-synced MP4 video using ElevenLabs text-to-speech).\n\nInstalls with `claude plugin install slidecast@claude-community` from `alinaqi/slidecast` (`plugins/slidecast`).",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
