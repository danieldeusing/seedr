{
  "slug": "synaptic",
  "name": "Synaptic",
  "type": "plugin",
  "description": "Persistent local memory for Claude Code — cross-session context, semantic search, zero cloud",
  "longDescription": "Ships **3 commands** and **1 MCP server**.\n\n- **Commands** (3): `list-checkpoints` (List recent checkpoints (project-scoped)), `load-checkpoint` (Load a saved checkpoint into current context), `save-checkpoint` (Save a named checkpoint of current progress to Synaptic)\n- **MCP servers** (1): `synaptic`\n\nInstalls with `claude plugin install synaptic@claude-community` from `HYPERLYNQ/synaptic`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "command": 3,
    "mcp": 1
  },
