{
  "slug": "ember-memory",
  "name": "Ember Memory",
  "type": "plugin",
  "description": "Persistent semantic memory for Claude Code. Stores knowledge in a\nlocal ChromaDB vector database and automatically retrieves relevant\ncontext on every message using Ollama bge-m3 embeddings. Everything\nruns locally — no API keys, no cloud, no data leaving your machine.",
  "longDescription": "Ships **1 MCP server**, `ember-memory`.\n\nInstalls with `claude plugin install ember-memory@claude-community` from `KindledFlameStudios/ember-memory`.\n\nYour AI forgets everything between sessions. Ember Memory fixes that.\n\nPersistent semantic memory for Claude Code. Stores knowledge in a\nlocal ChromaDB vector database and automatically retrieves relevant\ncontext on every message using Ollama bge-m3 embeddings. Everything\nruns locally — no API keys, no cloud, no data leaving your machine.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "mcp",
  "sourceType": "community",
  "author": {
