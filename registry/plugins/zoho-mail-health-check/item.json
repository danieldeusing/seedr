  "slug": "zoho-mail-health-check",
  "name": "Zoho Mail Health Check",
  "type": "plugin",
  "description": "Daily health check plugin for Zoho Mail accounts. Verifies that mail accounts are reachable, reads recent inbox messages, sends test emails, and saves a structured pass/fail report to the workspace. Designed for automated daily monitoring of business email accounts.",
