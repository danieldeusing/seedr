# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.turbo/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Testing
coverage/

# Misc
*.tgz
.cache/

# Python
__pycache__/

# Agent tooling — .agents/ is the canonical, tracked tree; agentwatch is a local-only tool
.agents/agentwatch/

# Generated by scripts/setup-agents.mjs (links into .agents/). No trailing slash:
# a trailing-slash pattern matches directories only, and git sees a symlink as a file.
.claude/skills
.claude/rules
.claude/agents

# Where a first-party item was copied from on this machine. Absolute paths that
# mean nothing in another checkout, and item.json is committed and served.
.seedr/

# Personal / local config (not for contributors)
CLAUDE.local.md
.claude/settings.local.json

# Remotion promo renders — the mp4/poster ship to pagr, not this repo
promo/out/
