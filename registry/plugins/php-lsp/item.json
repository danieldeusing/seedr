{
  "slug": "php-lsp",
  "name": "PHP LSP",
  "type": "plugin",
  "description": "PHP language server (Intelephense) for code intelligence",
  "longDescription": "Integrates Intelephense as a language server for PHP files (`.php`). Provides code intelligence, completions, go-to-definition, find references, and diagnostics. Install via `npm install -g intelephense` or `yarn global add intelephense`. No additional configuration required for standard PHP projects.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/a1ecfbc7f138a0ef455088f7f28cda2d22a0f853/plugins/php-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "intelephense": {
      "command": "intelephense",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".php": "php"
      }
    }
  },
