{
  "slug": "claude-code-organizer",
  "name": "Claude Code Organizer",
  "type": "plugin",
  "description": "Visual dashboard to organize all your Claude Code memories, skills, MCP servers, hooks, and configs. View everything in a scope hierarchy (Global > Workspace > Project), drag-and-drop items between scopes, search and filter across all customizations, preview file contents — all from a zero-dependency web UI.",
  "longDescription": "Ships **1 skill**, `organize` (Open the Cross-Code Organizer (CCO) dashboard — view and manage all memories, skills, MCP servers, hooks, and configs…) and **1 MCP server**, `cross-code-organizer`.\n\nInstalls with `claude plugin install claude-code-organizer@claude-community` from `mcpware/claude-code-organizer`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "mcp": 1
  },
