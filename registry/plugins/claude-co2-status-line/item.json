{
  "slug": "claude-co2-status-line",
  "name": "Claude Co2 Status Line",
  "type": "plugin",
  "description": "Adds a status line that estimates the environmental cost of your Claude Code session in real time. Shows cumulative energy usage (Wh), CO2\nemissions (g), water consumption (ml), and token count — updated after every interaction. Based on published research from Epoch AI, with all\nformulas and sources documented. Supports wrapping existing statuslines and opt-in all-time tracking.",
  "longDescription": "Ships **2 skills** and **1 hook**.\n\n- **Skills** (2): `setup` (Configure the CO2 status line in your Claude Code settings), `update` (Update CO2 status line to latest version with changelog display)\n- **Hooks** (1): `SessionStart`\n\nInstalls with `claude plugin install claude-co2-status-line@claude-community` from `stuartshields/claude-co2-status-line`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 2,
    "hook": 1
  },
