{
  "slug": "memex",
  "name": "Memex",
  "type": "plugin",
  "description": "Local AI memory system for Claude Code and Cursor. Remembers your preferences, decisions, and project context across sessions using a Go HTTP service and Qdrant vector database running locally in Docker. All data stays on your machine — nothing is sent to the cloud.",
  "longDescription": "Ships **1 skill**, `memex` (Use when you learn something about the user, their preferences, decisions, or project context that should be remembered…).\n\nInstalls with `claude plugin install memex@claude-community` from `Shvmvrshny/memex`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
