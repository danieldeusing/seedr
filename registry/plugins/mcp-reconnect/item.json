  "slug": "mcp-reconnect",
  "name": "Mcp Reconnect",
  "type": "plugin",
  "description": "Reconnect MCP servers in Claude Code tmux sessions via automated key injection. No API required — works by driving the /mcp interactive menu through tmux send-keys.",
