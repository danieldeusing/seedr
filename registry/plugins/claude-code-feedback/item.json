{
  "slug": "claude-code-feedback",
  "name": "Claude Code Feedback",
  "type": "plugin",
  "description": "Claude Code user plugin for filing well-formed bug reports, feature requests, model-behavior reports, and docs issues against anthropics/claude-code",
  "longDescription": "Ships **5 skills**.\n\n- **Skills** (5): `feedback-bug` (File a well-formed bug report against anthropics/claude-code), `feedback-docs` (File a documentation issue against anthropics/claude-code — missing docs, outdated docs, incorrect docs, or docs improvements), `feedback-feature-request` (File a well-formed feature request against anthropics/claude-code), `feedback-model-behavior` (File a report about Claude's model behavior (bad responses, refusals, hallucinations, policy misfires, poor code quality) against anthropics/claude-code), `feedback-refresh-templates` (Refresh cached Anthropic claude-code issue-form templates and detect drift or new template types)\n\nInstalls with `claude plugin install claude-code-feedback@claude-community` from `danielrosehill/Claude-Code-Feedback`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
