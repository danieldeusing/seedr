{
  "slug": "ruby-lsp",
  "name": "Ruby Lsp",
  "type": "plugin",
  "description": "Ruby language server for code intelligence and analysis",
  "longDescription": "Integrates Shopify's Ruby LSP into Claude Code for code intelligence across Ruby projects. Supports `.rb`, `.rake`, `.gemspec`, `.ru`, and `.erb` files. Provides language server features like go-to-definition, hover information, completion, diagnostics, and document symbols. Requires Ruby 3.0 or later. Install via `gem install ruby-lsp` or add to your Gemfile under the development group.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/f75f5b25ae94f4332be4ff5f18435741d2589bdb/plugins/ruby-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "ruby-lsp": {
      "command": "ruby-lsp",
      "extensionToLanguage": {
        ".rb": "ruby",
        ".rake": "ruby",
        ".gemspec": "ruby",
        ".ru": "ruby",
        ".erb": "erb"
      }
    }
  },
