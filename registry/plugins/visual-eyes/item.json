{
  "slug": "visual-eyes",
  "name": "Visual Eyes",
  "type": "plugin",
  "description": "Give Claude Code the ability to see running web applications. Visual Eyes captures screenshots via Playwright, lets Claude analyze the UI visually, auto-fix layout bugs, and run pixel-level regression testing. Works with any localhost app, zero config needed. Supports desktop, mobile, and full-page captures.",
  "longDescription": "Ships **1 skill**, `visual-eyes` (Give Claude Code eyes to see and analyze running web applications).\n\nInstalls with `claude plugin install visual-eyes@claude-community` from `nikolasdehor/visual-eyes`.\n\nClaude Code can write incredible code - but it's blind to the result.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
