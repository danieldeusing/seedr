{
  "slug": "knowledge-catalog",
  "name": "Knowledge Catalog",
  "type": "plugin",
  "description": "Connect to Knowledge Catalog to discover, manage, monitor, and govern data and AI artifacts across your data platform",
  "longDescription": "Ships **1 MCP server**, `dataplex`.\n\nInstalls with `claude plugin install knowledge-catalog@claude-plugins-official` from `gemini-cli-extensions/knowledge-catalog`.\n\nThis repository packages MCP Toolbox's prebuilt `dataplex` server as a plugin/extension to interact with Knowledge Catalog (formerly known as Dataplex) instances. It can be used with various AI agents, including Antigravity, Claude Code and Codex, to discover, manage, monitor, and govern data and AI artifacts across your data platform using natural language prompts.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
