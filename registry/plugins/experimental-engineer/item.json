{
  "slug": "experimental-engineer",
  "name": "Experimental Engineer",
  "type": "plugin",
  "description": "A Claude Code subagent that explores unconventional, first-principles solutions to hard technical problems, pushing Claude out of its normal tendency to play it safe and stick to the smeared average of its training data. Channels John Carmack-style fearless engineering.",
  "longDescription": "Ships **1 agent**, `eureka` (Use this agent when Claude is playing it safe, stuck looping on wrong hypotheses, or when standard fixes…) and **1 command**, `eureka` (Invoke the eureka subagent for first-principles, Carmack-style alternatives to a hard technical problem).\n\nInstalls with `claude plugin install experimental-engineer@claude-community` from `codyhxyz/experimental-engineer`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "agent": 1,
    "command": 1
  },
