{
  "slug": "claude-tab-fix",
  "name": "Claude Tab Fix",
  "type": "plugin",
  "description": "Fixes silent Edit failures caused by tab/space indentation mismatches in tab-indented files (Go, Templ, Rust,   Makefiles, and others).",
  "longDescription": "Ships **2 hooks**, `PreToolUse`, `PostToolUse`.\n\nInstalls with `claude plugin install claude-tab-fix@claude-community` from `WithHolm/claude-tab-fix`.\n\nA Claude Code hook that fixes indentation mismatches in `Edit` tool calls and warns Claude about the tab-separator ambiguity in `Read` output.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "hook",
  "sourceType": "community",
