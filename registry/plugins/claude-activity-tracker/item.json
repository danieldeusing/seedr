{
  "slug": "claude-activity-tracker",
  "name": "Claude Activity Tracker",
  "type": "plugin",
  "description": "Automatically tracks your Claude Code sessions, tool calls, edited files, and active time. Stores everything locally in SQLite — no cloud, no telemetry. Adds 9 MCP tools so Claude can reason about your own productivity data, plus a real-time web dashboard with charts at 127.0.0.1:8765/dashboard. Correlates AI sessions with GitHub commits, VSCode projects, and Plane issues.",
  "longDescription": "Ships **1 skill**, `activity` (Show Claude Code activity stats — sessions, tools used, files edited, and productivity metrics) and **1 MCP server**, `activity-tracker`.\n\nInstalls with `claude plugin install claude-activity-tracker@claude-community` from `Sent1nelX/claude-activity-tracker`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
