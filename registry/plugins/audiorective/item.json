{
  "slug": "audiorective",
  "name": "Audiorective",
  "type": "plugin",
  "description": "Web Audio toolkit for coding agents - reactive primitives, sample-accurate scheduling, and React/three.js bindings. Build synths, sequencers, and spatial audio without re-inventing the plumbing.",
  "longDescription": "Ships **1 skill**, `audiorective` (Use when building web audio applications — synthesizers, sequencers, DAWs, audio visualizers, spatial audio, or any app that…).\n\nInstalls with `claude plugin install audiorective@claude-community` from `audiorective/audiorective`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
