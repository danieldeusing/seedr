{
  "slug": "ultrapowers-dev",
  "name": "Ultrapowers Dev",
  "type": "plugin",
  "description": "Development skills language best practices for multiple languages, framework patterns, agentic patterns, and architecture fundamentals.",
  "longDescription": "Ships **55 skills**.\n\n- **Skills** (55): `agent-loop` (Use when a task requires autonomous multi-step reasoning with tool calls, where the number of steps is not…), `angular-patterns` (Use when building frontend applications with Angular — covers components, services, dependency injection, signals, standalone components, and testing), `api-design` (Use when designing REST APIs, choosing URL structures, handling errors in responses, implementing pagination, or planning API versioning), `architecture` (Use when making system-level architecture decisions, choosing between monolith and microservices, selecting architectural patterns, or designing system boundaries), `auth-security` (Use when implementing authentication, authorization, or security controls — covering identity, access, and defense against common vulnerabilities), `background-jobs` (Use when designing task queues, async workers, or event-driven processing that runs outside the request-response cycle), `browser-automation` (Use when an AI agent needs to interact with websites — navigating pages, filling forms, clicking buttons, taking…), `c-cpp-best-practices` (Use when writing or reviewing C/C++ code), and 47 more\n\nInstalls with `claude plugin install ultrapowers-dev@claude-community` from `ennio-datatide/ultrapowers-dev`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
