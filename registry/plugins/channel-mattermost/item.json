{
  "slug": "channel-mattermost",
  "name": "Channel Mattermost",
  "type": "plugin",
  "description": "Mattermost channel for Claude Code — two-way messaging bridge with built-in access control for self-hosted Mattermost instances. Manage pairing, allowlists, and policy via /mattermost:access",
  "longDescription": "Ships **2 skills** and **1 MCP server**.\n\n- **Skills** (2): `access` (Manage Mattermost channel access — approve pairings, edit allowlists, set DM/group policy), `configure` (Set up the Mattermost channel — save server URL and bot token, review access policy)\n- **MCP servers** (1): `mattermost`\n\nInstalls with `claude plugin install channel-mattermost@claude-community` from `todd-chamberlain/claude-channel-mattermost`.",
  "compatibility": [
    "claude",
    "copilot",
    "codex"
  ],
  "pluginType": "package",
