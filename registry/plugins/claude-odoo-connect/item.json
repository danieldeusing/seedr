  "slug": "claude-odoo-connect",
  "name": "Claude Odoo Connect",
  "type": "plugin",
  "description": "Connect Claude to your Odoo instance — search, read, and write Odoo data guided by 5,200+ lines of battle-tested knowledge modules",
