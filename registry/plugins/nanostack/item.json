{
  "slug": "nanostack",
  "name": "Nanostack",
  "type": "plugin",
  "description": "Minimal AI coding agent skills covering the full engineering workflow. Eight skills run an entire sprint: clarify intent, plan specs, detect scope drift, test with visual QA, audit security, and ship with quality checks. Skills share artifacts, accumulate knowledge between sessions, and can run end-to-end to a PR with --autopilot.",
  "longDescription": "Ships **1 command**, `nano-update` (Update nanostack to the latest version).\n\nInstalls with `claude plugin install nanostack@claude-community` from `garagon/nanostack`.\n\nYour AI agent writes code. Nanostack makes sure it ships work you can trust.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "wrapper",
  "wrapper": "command",
  "sourceType": "community",
  "author": {
    "name": "garagon"
  },
