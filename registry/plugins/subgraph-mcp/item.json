  "slug": "subgraph-mcp",
  "name": "Subgraph Mcp",
  "type": "plugin",
  "description": "Connect Claude to 15,000+ blockchain subgraphs via The Graph's Subgraph MCP server. Query DeFi, NFT, DAO, and governance data in natural language without writing GraphQL.",
