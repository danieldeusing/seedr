{
  "slug": "gsearch",
  "name": "Gsearch",
  "type": "plugin",
  "description": "Free Google Search grounding for AI CLI tools. Adds a google_search MCP tool that returns grounded answers with inline [1][2][3] citations and source URLs. Works with any Google account, no API key or billing required.",
