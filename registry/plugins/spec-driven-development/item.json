{
  "slug": "spec-driven-development",
  "name": "Spec Driven Development",
  "type": "plugin",
  "description": "Spec-Driven Development plugin for Claude Code and Cowork — a five-phase, spec-first workflow for planning and building software features. Includes Graphify integration.",
  "longDescription": "Ships **1 skill**, `sdd` (Spec-Driven Development (SDD) — a structured, specification-first development workflow).\n\nInstalls with `claude plugin install spec-driven-development@claude-community` from `GameFixxer/spec-driven-development`.\n\nA Claude Code / Cowork plugin that guides you through a structured, specification-first workflow for building software features — so you never jump straight into code again.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
  "sourceType": "community",
