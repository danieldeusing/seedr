{
  "slug": "memoriant-screen-recorder",
  "name": "Memoriant Screen Recorder",
  "type": "plugin",
  "description": "Screen recording for Claude Code. Record demos, tutorials, and bug reproductions directly from your coding session. Claude guides you through capture mode selection (full screen, region, window, or terminal-only), manages the recording session, and converts to optimized GIFs for READMEs and documentation. Works on macOS (screencapture) and Linux (ffmpeg). Includes demo automation for recording plugin showcases.",
  "longDescription": "Ships **1 skill**, `screen-recorder` (Manage screen recordings from within Claude Code) and **1 agent**, `screen-recorder-agent` (Manages screen recording sessions for demos, tutorials, and documentation).\n\nInstalls with `claude plugin install memoriant-screen-recorder@claude-community` from `NathanMaine/memoriant-screen-recorder-skill`.",
  "compatibility": [
    "claude",
    "copilot"
  ],
  "pluginType": "package",
