{
  "slug": "signet",
  "name": "Signet",
  "type": "plugin",
  "description": "Ed25519-signs every tool call and appends to a hash-chained, tamper-evident audit log. Zero config — signing starts immediately after install. No native dependencies (embedded WASM). Audit logs at ~/.signet/audit/ with optional CLI verification via signet audit --verify.",
  "longDescription": "Ships **1 skill**, `signet` (Cryptographic signing for every tool call with Ed25519 audit trail) and **1 hook**, `PostToolUse`.\n\nInstalls with `claude plugin install signet@claude-community` from `Prismer-AI/signet` (`plugins/claude-code`).\n\nCryptographic signing for every tool call in Claude Code. Ed25519 receipts + hash-chained audit log.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
