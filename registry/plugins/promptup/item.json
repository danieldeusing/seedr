{
  "slug": "promptup",
  "name": "Promptup",
  "type": "plugin",
  "description": "Automatically improves your prompts — better language, clearer instructions, smarter structure",
  "longDescription": "Ships **2 skills** and **1 hook**.\n\n- **Skills** (2): `pp` (Rewrite a prompt to be clearer, more specific, and more effective for AI), `pp-config` (Configure PromptUp settings — enable/disable, set mode, level, language, and more)\n- **Hooks** (1): `UserPromptSubmit`\n\nInstalls with `claude plugin install promptup@claude-community` from `zeglin/promptup`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 2,
    "hook": 1
  },
