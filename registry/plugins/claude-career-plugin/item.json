{
  "slug": "claude-career-plugin",
  "name": "Claude Career Plugin",
  "type": "plugin",
  "description": "AI job search command center for Claude Code. Evaluate job offers with fit scoring, generate tailored CVs and cover letters, scan 45+ company career portals automatically, track applications with a built-in pipeline, and prepare for interviews with STAR+R story generation. Turns Claude Code into a full recruiting assistant.",
  "longDescription": "Ships **1 skill**, **1 command** and **1 hook**.\n\n- **Skills** (1): `career-ops-init` (Set up a new career-ops workspace with directories, templates, and guided onboarding)\n- **Commands** (1): `career-ops` (AI job search command center -- evaluate offers, generate CVs, scan portals, track applications)\n- **Hooks** (1): `SessionStart`\n\nInstalls with `claude plugin install claude-career-plugin@claude-community` from `skytow/claude-career-plugin`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1,
    "command": 1
  },
