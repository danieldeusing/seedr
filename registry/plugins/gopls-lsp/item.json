{
  "slug": "gopls-lsp",
  "name": "Gopls LSP",
  "type": "plugin",
  "description": "Go language server for code intelligence and refactoring",
  "longDescription": "Integrates `gopls` as a language server for Go files (`.go`). Provides code intelligence, refactoring, and static analysis including go-to-definition, find references, and diagnostics. Install via `go install golang.org/x/tools/gopls@latest` and ensure `$GOPATH/bin` is in your `PATH`.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/340e33aef211d95769d252324854497af871dafe/plugins/gopls-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "gopls": {
      "command": "gopls",
      "extensionToLanguage": {
        ".go": "go"
      }
    }
