{
  "slug": "clangd-lsp",
  "name": "Clangd LSP",
  "type": "plugin",
  "description": "C/C++ language server (clangd) for code intelligence",
  "longDescription": "Integrates `clangd` as a language server for C and C++ files (`.c`, `.h`, `.cpp`, `.cc`, `.cxx`, `.hpp`, `.hxx`). Provides go-to-definition, find references, diagnostics, and code formatting. Installable via `brew install llvm` (macOS), `apt install clangd` / `dnf install clang-tools-extra` / `pacman -S clang` (Linux), or LLVM releases (Windows).",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/e0ab6e51219eef74e417a0e1d89e5d53e5e763d4/plugins/clangd-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "clangd": {
      "command": "clangd",
      "args": [
        "--background-index"
      ],
      "extensionToLanguage": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp",
        ".hpp": "cpp",
        ".hxx": "cpp",
        ".C": "cpp",
        ".H": "cpp"
      }
    }
  },
  "sourceRevision": "e0ab6e51219eef74e417a0e1d89e5d53e5e763d4",
