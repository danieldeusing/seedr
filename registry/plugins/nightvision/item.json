{
  "slug": "nightvision",
  "name": "Nightvision",
  "type": "plugin",
  "description": "Skills for working with NightVision, a DAST and API Discovery platform that finds exploitable vulnerabilities in web applications and REST APIs",
  "longDescription": "Ships **5 skills**.\n\n- **Skills** (5): `api-discovery` (Guide for agents to help users extract OpenAPI specs from source code using NightVision API Discovery), `app-security-scan` (DAST-first NightVision scan for an app you just built or changed), `ci-cd-integration` (Guide for agents to help users integrate NightVision DAST scanning into CI/CD pipelines), `scan-configuration` (Guide for agents to help users configure NightVision DAST scans), `scan-triage` (Guide for agents to help users interpret and act on NightVision DAST scan results)\n\nInstalls with `claude plugin install nightvision@claude-plugins-official` from `nvsecurity/nightvision-skills`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
