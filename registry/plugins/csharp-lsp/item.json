{
  "slug": "csharp-lsp",
  "name": "C# LSP",
  "type": "plugin",
  "description": "C# language server for code intelligence",
  "longDescription": "Integrates `csharp-ls` as a language server for C# files (`.cs`). Provides code intelligence including go-to-definition, find references, completions, and diagnostics. Requires .NET SDK 6.0 or later. Install via `dotnet tool install --global csharp-ls` or `brew install csharp-ls` on macOS.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "integration",
  "integration": "lsp",
  "sourceType": "official",
  "author": {
    "name": "Anthropic"
  },
  "externalUrl": "https://github.com/anthropics/claude-plugins-official/tree/b5b01ac4f889fec0c4c6bb89f27ca7c8574473f6/plugins/csharp-lsp",
  "marketplace": "claude-plugins-official",
  "version": "1.0.0",
  "strict": false,
  "lspServers": {
    "csharp-ls": {
      "command": "csharp-ls",
      "extensionToLanguage": {
        ".cs": "csharp"
      }
    }
