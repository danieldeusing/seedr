{
  "slug": "safety-net",
  "name": "Safety Net",
  "type": "plugin",
  "description": "Block destructive git and filesystem commands before execution",
  "longDescription": "Ships **1 skill**, `cc-safety-net` (Configure CC Safety Net rulebooks for user, project, or shareable GitHub scope) and **1 hook**, `PreToolUse`.\n\nInstalls with `claude plugin install safety-net@claude-community` from `kenryu42/claude-code-safety-net`.\n\nA PreToolUse hook that intercepts and blocks destructive git and filesystem commands before AI coding agents run them. CC Safety Net parses command semantics — so flag reordering, shell wrappers, and interpreter one-liners can't bypass it.",
  "compatibility": [
    "claude"
  ],
  "pluginType": "package",
  "package": {
    "skill": 1,
    "hook": 1
  },
  "sourceType": "community",
  "author": {
    "name": "J Liew"
  },
  "externalUrl": "https://github.com/kenryu42/claude-code-safety-net/tree/9fa3c5bdd9270776c7aafec08c0d51f6e323bbe5",
  "marketplace": "claude-community",
