{
  "slug": "shield",
  "name": "Shield",
  "type": "plugin",
  "description": "Security orchestrator — autonomous pentests, SAST, secrets scanning, dependency audits, and outdated checks from your code editor CLI. Wraps Shannon pentester with Semgrep, gitleaks, and package audit tools into a unified security workflow with risk scoring and fix proposals.",
  "longDescription": "Ships **2 skills**, `audit` (Intelligence-driven security analysis — the reasoning layer that complements Shield's tool-based scanning), `shield` (Orchestrates security scanning and autonomous penetration testing).\n\nInstalls with `claude plugin install shield@claude-community` from `alissonlinneker/shield-claude-skill`.",
  "compatibility": [
    "claude",
    "copilot",
    "antigravity",
    "codex"
  ],
  "pluginType": "wrapper",
  "wrapper": "skill",
